{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicoailleurs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}